// ============================================================
// TWISTEDAI — INDUSTRIAL PRISMA SCHEMA
// Supabase + Next.js 15 App Router
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

// ─────────────────────────────────────────────────────────────
// AUTH SCHEMA — Supabase managed, referenced only
// ─────────────────────────────────────────────────────────────
model users {
  id         String    @id @db.Uuid
  email      String?
  created_at DateTime? @db.Timestamptz(6)

  profile     profiles?
  links       links[]
  linkhistory linkhistory[]
  short_links short_links[]
  live_chat   live_chat[]

  @@map("users")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────
// PUBLIC SCHEMA — Application Tables
// ─────────────────────────────────────────────────────────────

/// User profile — auto-created via DB trigger on auth.users INSERT
model profiles {
  id           String   @id @db.Uuid
  username     String?  @unique
  email        String?  @unique
  display_name String?
  avatar_url   String?
  bio          String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([email])
  @@map("profiles")
  @@schema("public")
}

/// Anonymous inbox channel — each link = one unique inbox
model links {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_user_id String   @db.Uuid
  name            String
  view_count      Int      @default(0)
  is_public_inbox Boolean  @default(false)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  creator   users       @relation(fields: [creator_user_id], references: [id], onDelete: Cascade)
  messages  messages[]
  live_chat live_chat[]

  @@index([creator_user_id])
  @@index([created_at(sort: Desc)])
  @@map("links")
  @@schema("public")
}

/// History log of all links created by a user (powers /messages page)
model linkhistory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_user_id String   @db.Uuid
  link_id         String?  @db.Uuid
  content         String
  author_name     String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  creator users @relation(fields: [creator_user_id], references: [id], onDelete: Cascade)

  @@index([creator_user_id])
  @@index([created_at(sort: Desc)])
  @@map("linkhistory")
  @@schema("public")
}

/// Short link redirect table — /s/[slug] redirects to original_url
model short_links {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  original_url String
  creator_id   String   @db.Uuid
  click_count  Int      @default(0)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  creator users @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([creator_id])
  @@map("short_links")
  @@schema("public")
}

/// Anonymous messages sent to an inbox link
model messages {
  id          BigInt   @id @default(autoincrement())
  link_id     String   @db.Uuid
  content     String
  author_name String   @default("Anonymous")
  reply       String?
  is_public   Boolean  @default(false)
  is_read     Boolean  @default(false)
  spy         Json?
  master_id   String?
  lat         String?
  lng         String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  link links @relation(fields: [link_id], references: [id], onDelete: Cascade)

  @@index([link_id])
  @@index([created_at(sort: Desc)])
  @@index([is_public])
  @@index([is_read])
  @@map("messages")
  @@schema("public")
}

/// Realtime spy chat between inbox owner and anonymous visitor
model live_chat {
  id              BigInt   @id @default(autoincrement())
  link_id         String?  @db.Uuid
  master_id       String
  content         String
  sender_name     String?
  creator_user_id String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  link    links? @relation(fields: [link_id], references: [id], onDelete: SetNull)
  creator users? @relation(fields: [creator_user_id], references: [id], onDelete: SetNull)

  @@index([master_id])
  @@index([link_id])
  @@index([created_at(sort: Desc)])
  @@map("live_chat")
  @@schema("public")
}

/// AI-generated image cards (stored in Supabase Storage)
model cards {
  id          BigInt   @id @default(autoincrement())
  message     String?
  reply       String?
  prompt_used String?
  image_url   String?
  model_used  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)])
  @@map("cards")
  @@schema("public")
}
